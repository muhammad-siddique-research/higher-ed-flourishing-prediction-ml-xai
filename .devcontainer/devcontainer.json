{
  "name": "Higher Education Flourishing | Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/streamlit_app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": "streamlit run app/streamlit_app.py --server.address 0.0.0.0 --server.port 8501",
  "portsAttributes": {
    "8501": {"label": "Policy research demo", "onAutoForward": "openPreview"}
  },
  "forwardPorts": [8501]
}
